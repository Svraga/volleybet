// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom app fields
  leagueId      String?
  league        League?   @relation(fields: [leagueId], references: [id])
  bets          Bet[]
  accounts      Account[]
  sessions      Session[]
  ledgers       Ledger[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model League {
  id            String    @id @default(cuid())
  name          String
  inviteCode    String    @unique
  adminId       String    // User ID of the creator
  homeTeam      String
  coinName      String    @default("Coin")
  
  users         User[]
  matchDays     MatchDay[]
  ledgers       Ledger[]
  teams         Team[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MatchDay {
  id            String    @id @default(cuid())
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id])
  number        Int
  deadline      DateTime
  status        String    @default("OPEN") // OPEN, CLOSED, SCORED
  
  matches       Match[]
  ledgers       Ledger[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Match {
  id            String    @id @default(cuid())
  matchDayId    String
  matchDay      MatchDay  @relation(fields: [matchDayId], references: [id])
  teamA         String
  teamB         String
  resultA       Int?      // Sets won by team A (0, 1, 2, 3)
  resultB       Int?      // Sets won by team B (0, 1, 2, 3)
  
  bets          Bet[]
}

model Bet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  matchId       String
  match         Match     @relation(fields: [matchId], references: [id])
  predictedA    Int
  predictedB    Int
  pointsEarned  Int?      // 3, 1, 0
  
  @@unique([userId, matchId])
}

model Ledger {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  leagueId      String
  league        League    @relation(fields: [leagueId], references: [id])
  amount        Float       // + or -
  reason        String    // e.g. "Bet placed", "Payout MatchDay X"
  matchDayId    String?   // optional link to match day
  matchDay      MatchDay? @relation(fields: [matchDayId], references: [id])
  createdAt     DateTime  @default(now())
}

model Team {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  name      String
}
